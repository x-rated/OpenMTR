// app.rc — embeds app.ico and version metadata into the executable
#include <windows.h>

IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Rudolf Slambera"
            VALUE "FileDescription",  "OpenMTR — Network Diagnostic Tool"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "OpenMTR"
            VALUE "LegalCopyright",   "GPL v2"
            VALUE "OriginalFilename", "OpenMTR.exe"
            VALUE "ProductName",      "OpenMTR"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
