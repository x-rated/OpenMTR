// ===========================================================================
//  app.rc.in — Windows resource script (template)
//
//  CMake's configure_file() expands the @...@ placeholders into app.rc at
//  build time, embedding the icon and version info into the executable.
// ===========================================================================

#include <windows.h>

// Application icon (Explorer / taskbar).
IDI_APPICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/app_icon.ico"

// Version information block embedded in the .exe.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = US English, 04B0 = Unicode code page.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Rudolf Slambera"
            VALUE "FileDescription",  "OpenMTR - Network Diagnostic Tool"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "OpenMTR"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Rudolf Slambera (GPLv2)"
            VALUE "OriginalFilename", "OpenMTR.exe"
            VALUE "ProductName",      "OpenMTR"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // Must match the language/code-page used in the StringFileInfo block.
        VALUE "Translation", 0x0409, 0x04B0
    END
END
